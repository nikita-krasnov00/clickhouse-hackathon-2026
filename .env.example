# Insight Desk — шаблон env. Скопируйте в .env и заполните значения.
# .env в git не коммитится (.gitignore); этот файл — остаётся.

# ClickHouse Cloud — host:port БЕЗ протокола (https:// добавляется в коде),
# например: abc123.eu-west-1.aws.clickhouse.cloud:8443
CLICKHOUSE_URL=
# Админ-доступ (провижининг, перелив слайса — трек A)
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Read-only юзер для SQL агента и drill-запросов (создаёт A1)
AGENT_RO_USER=
AGENT_RO_PASSWORD=
# Юзер с записью в базу scratch: temp tables, кэш схемы (создаёт A1)
AGENT_SCRATCH_USER=
AGENT_SCRATCH_PASSWORD=

# Trigger.dev cloud: Project settings → Project ref
TRIGGER_PROJECT_REF=
# Trigger.dev cloud: API Keys (tr_dev_… локально, tr_prod_… на деплое)
TRIGGER_SECRET_KEY=

# LLM (OpenRouter)
OPENROUTER_API_KEY=
# Опционально: модель OpenRouter. Пусто — дефолтная цепочка MiniMax (llm.ts).
# Можно указать полный слаг (openai/gpt-5.6-terra, minimax/minimax-m3) или
# короткий алиас (gpt-5.6-terra, gpt-5.6-terra-pro, minimax-m3).
LLM_MODEL=

# Опционально: целевая таблица расследований и её колонка даты
# (дефолты: github.github_events / created_at — см. src/lib/config.ts)
GITHUB_EVENTS_TABLE=
GITHUB_EVENTS_DATE_COLUMN=
