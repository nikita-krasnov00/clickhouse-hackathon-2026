# Insight Desk — шаблон env. Скопируйте в .env и заполните значения.
# .env в git не коммитится (.gitignore); этот файл — остаётся.

# ClickHouse Cloud — host:port БЕЗ протокола (https:// добавляется в коде),
# например: abc123.eu-west-1.aws.clickhouse.cloud:8443
CLICKHOUSE_URL=
# Админ-доступ (провижининг, перелив слайса — трек A)
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Read-only юзер для SQL-агента (создаёт A1)
AGENT_RO_USER=
AGENT_RO_PASSWORD=
# Юзер с записью в базу scratch: temp tables, кэш схемы (создаёт A1)
AGENT_SCRATCH_USER=
AGENT_SCRATCH_PASSWORD=

# Trigger.dev cloud: Project settings → Project ref
TRIGGER_PROJECT_REF=
# Trigger.dev cloud: API Keys → dev-ключ (tr_dev_…) для локальной разработки
TRIGGER_SECRET_KEY=
# Trigger.dev cloud: API Keys → prod-ключ (tr_prod_…). Нужен только скрипту
# vercel-env-push.sh — он заливает его на Vercel как TRIGGER_SECRET_KEY
TRIGGER_SECRET_KEY_PROD=

# LLM (OpenRouter)
OPENROUTER_API_KEY=
# Опционально: модель OpenRouter. Пусто — дефолтная цепочка MiniMax (llm.ts).
# Можно указать полный слаг (openai/gpt-5.6-terra, minimax/minimax-m3) или
# короткий алиас (gpt-5.6-terra, gpt-5.6-terra-pro, minimax-m3).
LLM_MODEL=
# Опционально: быстрая модель — триаж вопроса и подсказки-пресеты (/api/suggest),
# где важна латентность первого ответа. Пусто — дефолт openai/gpt-5.6-terra
# (llm.ts); алиасы работают те же, что у LLM_MODEL.
LLM_MODEL_FAST=

# Вход на фронтенд — Google OAuth через NextAuth (README → «Google OAuth»).
# Секрет подписи сессионных cookie: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (и то же самое на прод-домене Vercel).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Опционально: кому разрешён вход — email через запятую.
# Пусто — любой Google-аккаунт (режим для жюри).
AUTH_ALLOWED_EMAILS=
